---
import "../styles/route.css";
---

<section class="route">
  <div class="container">

    <h2>Unsere Route durch Kulmbach</h2>

    <p class="route-intro">
      Die Demonstration startet im Gasfabrikgäßchen und führt durch die Innenstadt bis zum Marktplatz.
    </p>

    <div class="route-content">

      <!-- LINKS: ROUTE -->
      <div class="route-list">

        <div class="route-item red">
          <span>Start: Gasfabrikgäßchen Kulmbach</span>
        </div>

        <div class="route-item orange">
          <span>Fritz-Hornschuch-Straße</span>
        </div>

        <div class="route-item yellow">
          <span>Kressenstein</span>
        </div>

        <div class="route-item green">
          <span>Langgasse</span>
        </div>

        <div class="route-item blue">
          <span>Oberhacken / Obere Stadt</span>
        </div>

        <div class="route-item violet">
          <span>Ziel: Marktplatz Kulmbach</span>
        </div>

      </div>

      <!-- RECHTS: GIF (CLICKABLE) -->
      <div class="route-media">

        <button class="route-media-btn" id="openRouteGif">
          <img src="/route.webp" alt="Route Visualisierung CSD Kulmbach" />
        </button>

      </div>

    </div>

  </div>
</section>

<!-- LIGHTBOX -->
<div class="lightbox" id="lightbox">
  <img src="/route.webp" alt="Route groß" />
</div>

<!-- SCRIPT -->
<script>
  const btn = document.getElementById("openRouteWEBP");
  const lightbox = document.getElementById("lightbox");

  btn.addEventListener("click", () => {
    lightbox.classList.add("active");
  });

  lightbox.addEventListener("click", () => {
    lightbox.classList.remove("active");
  });
</script>