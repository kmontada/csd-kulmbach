---
import { faq } from "../data/faq";
---

<section class="faq" id="faq">

  <div class="container">

    <p class="section-label">FAQ</p>

    <h2>Häufige Fragen.</h2>

    <p class="faq-intro">
      Hier findest du Antworten auf die wichtigsten Fragen rund um den
      Christopher Street Day Kulmbach.
    </p>

    <div class="faq-list">

      {faq.map((item) => (
        <details class="faq-item">

          <summary>
            <span>{item.question}</span>
            <span class="plus">+</span>
          </summary>

          {typeof item.answer === "string" ? (
            <p>{item.answer}</p>
          ) : (
            <div class="faq-answer">

              {item.answer.map((block, index) => (
                <div class="faq-block" key={index}>

                  {block.intro && <p><strong>{block.intro}</strong></p>}

                  {block.points && (
                    <ul>
                      {block.points.map((point) => (
                        <li>{point}</li>
                      ))}
                    </ul>
                  )}

                  {block.outro && <p>{block.outro}</p>}

                </div>
              ))}

            </div>
          )}

        </details>
      ))}

    </div>

    {/* =========================
        FOOTER SPONSORS
    ========================= */}

    <div class="footer-sponsors-section">

      <h3 class="sponsors-title">
        Wir bedanken uns bei unseren zahlreichen Sponsoren und Kooperationspartnern für die Unterstützung.
      </h3>

      <div class="footer-sponsors">

        <a href="https://amnesty-kulmbach.de" target="_blank" rel="noopener noreferrer">
          <img src="/amnestylogo.webp" alt="Amnesty International" />
        </a>

        <a href="https://franzundgloria.de" target="_blank" rel="noopener noreferrer">
          <img src="/fglogo.webp" alt="Franz & Gloria" />
        </a>

        <a href="https://cantine-ruin.de" target="_blank" rel="noopener noreferrer">
          <img src="/cantineruin.webp" alt="Cantine Ruin" />
        </a>

        <a href="https://neue-filmbuehne.de" target="_blank" rel="noopener noreferrer">
          <img src="/filmbuehnelogo.webp" alt="Filmbühne" />
        </a>

        <a href="https://www.raps-stiftung.de" target="_blank" rel="noopener noreferrer">
          <img src="/arslogo.webp" alt="Adalbert Raps Stiftung" />
        </a>

